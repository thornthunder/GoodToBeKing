# The war game (see CLAUDE.md, "The war game"): copy to war.env on the court VM.
# The war server (a second Bedrock server, server/war-server.sh).
MC_HOST=127.0.0.1
MC_PORT=19134
MC_TRANSPORT=nethernet
MC_WEBRTC=wrtc
MC_OFFLINE=true
# The models, as the court uses them.
OLLAMA_HOST=http://ava:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_ORDER_MODEL=gemma4:31b
OLLAMA_MEMORY_MODEL=gemma4:31b
OLLAMA_WAR_MODEL=gemma4:31b
LOG_LEVEL=info
# The referee's season (config/war/arena.json has the defaults): shorter for a trial run.
#WAR_BUILD_CYCLES=1
#WAR_RAID_CYCLES=1
#WAR_ROUNDS=3
#WAR_SERIES=3
