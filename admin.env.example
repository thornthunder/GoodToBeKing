# The court's admin (compose.admin.yaml). Copy to admin.env (git-ignored) and fill in. Compose
# reads it for the folders to mount (--env-file admin.env), and the admin for its settings.

# Where the page listens (the machine's own address, with host networking).
ADMIN_PORT=8080
ADMIN_HOST=0.0.0.0

# The worlds, in the order the page shows them: id=checkout folder on the host. Each checkout is
# also mounted below (WORLD_DIR_1, WORLD_DIR_2).
ADMIN_WORLDS=dev=/home/you/court-test,creative=/home/you/GoodToBeKing
WORLD_DIR_1=/home/you/court-test
WORLD_DIR_2=/home/you/GoodToBeKing
# The folder both worlds share (COURT_SHARED in the worlds' .env).
SHARED_DIR=/home/you/court-shared

# The Bedrock server on this machine, if any: its systemd service=its folder, and the world that
# plays on it. Start/stop needs server/install-bds-control.sh run once on the host.
ADMIN_SERVER=bds-test=/home/you/testserver
SERVER_DIR=/home/you/testserver
ADMIN_SERVER_WORLD=dev

# Backups, and the admin's own folder (its password hash and audit log).
ADMIN_BACKUPS=/home/you/backups
ADMIN_DATA_DIR=/home/you/court-admin

# The Ollama servers the admin knows at first start (name=url, comma-separated); then edited on
# the Ollama page.
ADMIN_OLLAMA=Ava=http://ava:11434

# The host's docker group id (getent group docker), for the Docker socket.
DOCKER_GID=999

# The password at first start. Empty: the admin makes one and writes it to
# ADMIN_DATA_DIR/first-password.txt (change it on the page, then this is no longer read).
ADMIN_PASSWORD=

# The court's database (compose.db.yaml, db.env.example): history and the audit log. Empty: none.
DATABASE_URL=
# The container it runs in (backups are pg_dump in it).
ADMIN_DB_CONTAINER=goodtobeking-db
