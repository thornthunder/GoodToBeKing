# The court's database (compose.db.yaml). Copy to db.env (git-ignored) on the machine; then
#   docker compose -f compose.db.yaml --env-file db.env up -d
# and give the courts and the admin DATABASE_URL=postgres://court:<password>@127.0.0.1:5432/court
# (each world's .env, admin.env).
# A long random password (letters and digits keep the URL simple): openssl rand -hex 24
DB_PASSWORD=
# Where Postgres keeps its files (a host folder; back up with pg_dump, the admin's Backups page).
DB_DATA_DIR=/home/you/court-db
