# ---- Minecraft Bedrock server to join ----------------------------------------
MC_HOST=127.0.0.1
MC_PORT=19132
# Leave empty to auto-detect the protocol version from the server's ping reply.
MC_VERSION=
# RakNet implementation: raknet-native (default, C++) or jsp-raknet (pure JS).
# jsp-raknet only speaks RakNet protocol 10, which servers newer than 1.19.30 reject,
# so leave this empty for real servers.
MC_RAKNET_BACKEND=
# true  = no Microsoft/Xbox login; the server must run with online-mode=false.
# false = sign in with a Microsoft account via device code (printed in the log).
MC_OFFLINE=true
# Where Microsoft auth tokens are cached when MC_OFFLINE=false (git-ignored).
MC_PROFILES_FOLDER=.auth-cache

# ---- Bot identity -------------------------------------------------------------
BOT_NAME=Merlin
# Free-text description of how the bot should behave in chat. Empty = built-in default.
BOT_PERSONA=
# Said once in chat right after spawning. Empty = say nothing.
BOT_GREETING=
# true = react to every chat line; false = only when addressed by name or whispered.
BOT_RESPOND_TO_ALL=false
# Minimum gap between two replies from the bot.
BOT_CHAT_COOLDOWN_MS=3000
# Reconnect with backoff when the connection drops.
BOT_AUTO_RECONNECT=true

# ---- Ollama -------------------------------------------------------------------
OLLAMA_HOST=http://ava:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TEMPERATURE=0.7
# Abort an inference request after this long.
OLLAMA_TIMEOUT_MS=60000
# Empty = auto: thinking is switched off on models that support it (much faster replies).
# true forces thinking on, false forces it off.
OLLAMA_THINK=
# Context window override. Empty = model default.
OLLAMA_NUM_CTX=
# Model for background memory extraction (what the court remembers about the royals).
# It never delays a reply, so a bigger model is fine. Empty = use OLLAMA_MODEL.
OLLAMA_MEMORY_MODEL=gemma4:12b
# How long Ollama keeps the model loaded between requests. Long, so the first reply after a
# quiet spell is not slowed by a 4-5 s reload; Ollama still frees idle models when it needs room.
OLLAMA_KEEP_ALIVE=24h

# ---- Multiple bots ------------------------------------------------------------
# Path to a JSON array of per-bot overrides; see config/bots.example.json.
# Every bot starts from the values above and overrides only what the file sets.
BOTS_FILE=

# debug | info | warn | error
LOG_LEVEL=info

# ---- Royal court ----------------------------------------------------------------
# Roster of royal players (git-ignored). Copy config/court.example.json to start.
COURT_FILE=config/court.json
# Answer every chat line from a royal, even without the bot's name in it.
BOT_RESPOND_TO_ROYALS=true
# Welcome non-royal players when they join. Royals are always hailed.
BOT_GREET_VISITORS=true
